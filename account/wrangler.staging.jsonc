{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "native-account-broker-staging-v15",
  "main": "broker.ts",
  "compatibility_date": "2026-09-07",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "account-staging.klappy.dev", "custom_domain": true, "zone_id": "d3fb39dede08497b44146266cc7c6d4e" }],
  "observability": { "enabled": false },
  "vars": {
    "GITHUB_CLIENT_ID": "Ov23li2Uh9UpIBa5Ezn6",
    "BROWSER_SESSION_KEY_ID": "browser-staging-v15-20260908-03",
    "ACCOUNT_JWKS": "{\"keys\":[{\"kty\":\"EC\",\"crv\":\"P-256\",\"x\":\"EZXZZBTj8ryDQGa-jSLhbTtyogfr5VHe66tea7-A9FA\",\"y\":\"fZDetzynoGjNikQgZiiz62w4vqha8dVyPkcFaqfWgX8\",\"kid\":\"account-staging-v15-20260908-03\",\"alg\":\"ES256\",\"use\":\"sig\"}]}",
    "SERVICE_JWKS": "{\"keys\":[{\"kty\":\"EC\",\"crv\":\"P-256\",\"x\":\"Z9bDX-lgPvJOn0CS21rmIUjSzT9Jw5V2F0sJeEuXvzM\",\"y\":\"0TMr-pqpWG6rJKWQ9rbYYWwL-z1G_AappJEzfK-JZqA\",\"kid\":\"cartographer-staging-v15-20260908-04\",\"alg\":\"ES256\",\"use\":\"sig\"}]}",
    "PRIVATE_ACTIVATION": "disabled",
    "STAGING_CLIENT_REGISTRATION": "disabled",
    "STAGING_METADATA_DISCOVERY": "enabled",
    "ACCOUNT_ISSUER": "https://account-staging.klappy.dev",
