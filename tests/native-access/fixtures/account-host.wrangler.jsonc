{
  "$schema": "../../../node_modules/wrangler/config-schema.json",
  "name": "native-account-local-host-fixture",
  "main": "account-host-worker.ts",
  "compatibility_date": "2026-06-16",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "durable_objects": { "bindings": [{ "name": "ACCOUNT_GRANTS", "class_name": "AccountGrantObject" }] },
  "migrations": [{ "tag": "fixture-v1", "new_sqlite_classes": ["AccountGrantObject"] }],
  "kv_namespaces": [{ "binding": "ACCOUNT_CONNECTOR_KV", "id": "local-synthetic-connector", "remote": false }]
}
